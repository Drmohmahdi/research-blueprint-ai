# Production environment reference for the Hostinger VPS.
# Copy to backend/.env on the server and fill in real values — never commit it.

PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production
COOKIE_SECURE=true
SESSION_TTL_DAYS=7
AUTO_CREATE_TABLES=false

# Frontend origins allowed to call this API (comma-separated, no trailing slash).
# Include the Vercel testing domain(s) alongside the final production domain.
CORS_ORIGINS=https://research-blueprint-ai.vercel.app,https://your-final-domain.com
TRUSTED_HOSTS=api.your-final-domain.com
APP_URL=https://your-final-domain.com
LOG_LEVEL=INFO
SLOW_REQUEST_MS=1000

# Use a real PostgreSQL instance in production — not SQLite.
DATABASE_URL=postgresql://user:password@localhost:5432/research_blueprint

GEMINI_API_KEY=
AI_PROVIDER=auto

# Optional providers. Blank means not configured; readiness remains available.
PAYMENT_API_KEY=
PAYMENT_PROVIDER_MODE=SANDBOX
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
