# FastAPI Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Database Configuration (SQLite by default, PostgreSQL in production)
DATABASE_URL=sqlite:///./research_blueprint.db

# Gemini API Configuration (Optional: falls back to rule-based engine if blank)
GEMINI_API_KEY=
