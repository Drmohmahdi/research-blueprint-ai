[Unit]
Description=Research Blueprint AI backend (FastAPI/uvicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/research-blueprint-ai/backend
EnvironmentFile=/var/www/research-blueprint-ai/backend/.env
ExecStart=/var/www/research-blueprint-ai/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
