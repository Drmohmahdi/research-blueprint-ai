# Frontend (Vite). Copy to .env.local for local overrides — never commit secrets.
VITE_API_BASE_URL=http://localhost:8000/api

# Optional. When set, gtag.js loads. Funnel events already go to window.dataLayer:
# page_view, view_pricing, generate_lead, begin_registration, create_first_project, plan_limit_reached.
VITE_GA_MEASUREMENT_ID=
